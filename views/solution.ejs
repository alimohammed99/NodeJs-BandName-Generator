<%- include("partials/solution-header.ejs") %>

  <section class="generator-card" aria-labelledby="page-title">
    <div class="brand-mark" aria-hidden="true">✦</div>
    <p class="eyebrow">The band name generator</p>

    <% if (locals.adjective && locals.noun) { %>
      <h1 id="page-title" class="band-name">
        <span><%= adjective %></span>
        <span class="band-name-accent"><%= noun %></span>
      </h1>
      <p class="description">Sounds like a band worth listening to.</p>
    <% } else { %>
      <h1 id="page-title">Your next big<br>name starts here.</h1>
      <p class="description">A little inspiration for your future tour poster.</p>
    <% } %>

    <form action="/submit" method="POST">
      <button class="generate-button" type="submit">
        <span>Generate a band name</span>
        <span class="button-icon" aria-hidden="true">↗</span>
      </button>
    </form>

    <p class="hint">One click. One name. A whole new sound.</p>
  </section>

  <%- include("partials/solution-footer.ejs") %>
